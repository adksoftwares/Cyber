INGEST_KEY=replace-with-a-long-random-ingest-key
ADMIN_KEY=replace-with-a-long-random-admin-key
# Optional: Cloudflare zone-level IP Access Rules. Use a narrowly scoped API token.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# JSON array of browser origins allowed to call the API
ALLOWED_ORIGINS=["http://localhost:5173"]
# Frontend build-time API origin (set in frontend/.env when developing)
# VITE_API_URL=http://localhost:8000

# Optional AlienVault OTX subscribed-pulse API key
OTX_API_KEY=
